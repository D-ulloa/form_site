# Public Supabase Auth configuration. The anon/publishable key is safe to
# expose in the browser; never put SUPABASE_SERVICE_ROLE_KEY here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
# Synthetic local registration UI fixture only; never set in a real-data build.
VITE_ALLOW_SYNTHETIC_REGISTRATION=false
