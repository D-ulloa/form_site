# Server
NODE_ENV=development
PORT=3001

# Number of trusted reverse-proxy hops. Keep 0 when connecting directly.
TRUST_PROXY_HOPS=0

# Media upload strategy
# Use 'supabase' for client-direct uploads or 'drive' for legacy uploads.
MEDIA_UPLOAD_PROVIDER=supabase
MEDIA_UPLOAD_LEGACY_DRIVE_WRITE=false
MAX_MEDIA_FILES=20
MEDIA_UPLOAD_SESSION_TTL_MS=600000
MEDIA_UPLOAD_MAX_SESSIONS=1000

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The frontend uses the matching public project URL and anon/publishable key
# for Google OAuth. Never use the service-role key in VITE_* variables.
SUPABASE_MEDIA_BUCKET=property-media
SUPABASE_UPLOAD_PATH_PREFIX=properties
SUPABASE_SIGNED_UPLOAD_TTL_SECONDS=900
SUPABASE_SIGNED_DOWNLOAD_TTL_SECONDS=900

# Staged SPEC-28 platform controls. Required only when SPEC-27 activates
# multi-tenant routes; keep secrets in the deployment secret manager.
PLATFORM_RATE_LIMIT_PEPPER=
PLATFORM_CURSOR_SECRET=
PLATFORM_AUDIT_REQUIRED=true
# Never enable on the normal customer-facing process.
PLATFORM_RESTORE_MODE=false

# SPEC-27 revocable application sessions. Use independent secret-manager values.
APP_SESSION_PEPPER=
APP_CSRF_PEPPER=
APP_API_KEY_PEPPER=
APP_ALLOWED_ORIGINS=http://localhost:5173
APP_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/auth/reset
APP_SESSION_TTL_SECONDS=28800
APP_REMEMBERED_SESSION_TTL_SECONDS=2592000
APP_SESSION_IDLE_TTL_SECONDS=1800
APP_MAX_ACTIVE_SESSIONS=10
# No support runtime exists until a separate security approval enables it.
SUPPORT_ACCESS_ENABLED=false

# SPEC-35 server-only identity/profile provisioning. Keep disabled until the
# migration, operator approvals, identity inventory, and provider tests pass.
IDENTITY_PROVISIONING_ENABLED=false
IDENTITY_PROVISIONING_DEFAULT_DISPLAY_NAME=Usuario invitado
IDENTITY_PROVISIONING_DEFAULT_LOCALE=es
IDENTITY_PROVISIONING_DEFAULT_TIME_ZONE=America/Caracas
# Independent 32+ byte secret used only to fingerprint canonical emails.
IDENTITY_PROVISIONING_EMAIL_PEPPER=
APP_AUTH_ACTIVATION_REDIRECT_URL=http://localhost:5173/auth/callback

# SPEC-36 restricted organization bootstrap command. Keep the execution gate false
# except during an approved restricted command window.
ORGANIZATION_PROVISIONING_ENABLED=false

# The remaining values belong only in the controlled operations process, never
# the customer-facing web runtime.
PLATFORM_PROVISIONING_ENVIRONMENT=production
PLATFORM_PROVISIONING_PROJECT_REF=
PLATFORM_PROVISIONING_DEPLOYMENT_IDENTITY=
PLATFORM_PROVISIONING_APPROVAL_REFERENCE=
# UUID of a fresh, unrevoked AAL2 app_sessions row for the named manifest operator.
PLATFORM_PROVISIONING_STEP_UP_SESSION_ID=

# SPEC-37 invite delivery. Manual links need the migration and application
# security checks; email mode additionally needs provider/domain/webhook certification.
INVITATION_ROUTES_ENABLED=false
INVITATION_DELIVERY_METHOD=share_link
INVITATION_EMAIL_ADAPTER=disabled
INVITATION_PUBLIC_BASE_URL=http://localhost:5173
INVITATION_EMAIL_TEMPLATE_VERSION=v1
# Independent 32+ byte secrets; keep server-side and rotate through the secret manager.
INVITATION_PROVIDER_REFERENCE_PEPPER=
INVITATION_ALERT_OWNER=
INVITATION_EMAIL_TIMEOUT_MS=5000
INVITATION_EMAIL_FROM=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Google service account JSON, minified onto one line.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
# Optional Workspace domain-wide delegation subject.
GOOGLE_SUBJECT_EMAIL=

# Property-submission Google Sheet
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1!A1

# Contract Generation (SPEC-10 through SPEC-19)
# Local frontend origin used when issuing user/client links. Vercel Preview
# deployments use the current deployment's automatic VERCEL_URL instead.
CONTRACT_PUBLIC_BASE_URL=http://localhost:5173
# At least 32 random characters. HMACs external contract role tokens.
CONTRACT_TOKEN_SECRET=
# At least 32 random characters. Signs application-session cookies independently.
# Increment CONTRACT_SESSION_VERSION to invalidate all legacy admin sessions.
CONTRACT_SESSION_SECRET=
CONTRACT_SESSION_VERSION=spec25-containment-v1
# Optional server-to-server Bearer key. Never expose this as a VITE_* value.
CONTRACTS_API_KEY=
# Synthetic local fixture only. Never set outside exact NODE_ENV=development.
CONTRACT_ALLOW_SYNTHETIC_REGISTRATION=false
# Enable only behind a reviewed proxy that strips caller values and inserts a
# verified X-Authenticated-User-Id. Direct backend exposure must keep this false.
CONTRACT_TRUSTED_GATEWAY_ENABLED=false
# Temporary Azar allowlist inputs must be reviewed and frozen.
CONTRACT_ADMIN_USER_IDS=
# In-memory defense-in-depth limits; deploy an edge/distributed limiter for
# horizontally scaled production environments.
CONTRACT_SUBMISSION_RATE_LIMIT=10
CONTRACT_SUBMISSION_RATE_WINDOW_MS=900000
# Private Supabase Storage bucket for tenant/guarantor DNI image pairs.
# The SPEC-11 migration provisions this default bucket with a 10 MB object cap.
CONTRACT_DNI_STORAGE_BUCKET=contract-dni
CONTRACT_DNI_MAX_IMAGE_BYTES=10485760
# Require both Frontal and Dorso DNI files for visible DNI receivers.
CONTRACT_DNI_UPLOADS_REQUIRED=true
# Private Supabase Storage bucket for salary-receipt/property-guarantee files.
# The SPEC-14 migration provisions this default bucket with a 10 MB object cap.
CONTRACT_EVIDENCE_STORAGE_BUCKET=contract-evidence
CONTRACT_EVIDENCE_MAX_FILE_BYTES=10485760
# Bounded post-commit contract Make worker pass.
CONTRACT_MAKE_WORKER_LIMIT=10
# Optional standalone worker identity; defaults to a process-derived value.
CONTRACT_MAKE_WORKER_ID=

# Legacy SPEC-09 compatibility endpoints only. The live UI does not use these.
CONTRACT_GOOGLE_FORM_LINK=
CONTRACT_GOOGLE_SHEET_ID=
CONTRACT_GOOGLE_SHEET_NAME=
CONTRACT_AUDIT_LOGS_DIR=

# Google Drive parent for property folders
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# Make webhook
MAKE_WEBHOOK_URL=

# Property-flow User OAuth2 credentials. Contract writes always use the
# service account above and never fall back to these values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
