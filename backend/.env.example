# Server
NODE_ENV=development
PORT=3001

# Number of trusted reverse-proxy hops. Keep 0 when connecting directly.
TRUST_PROXY_HOPS=0

# Media upload strategy
# Use 'supabase' for client-direct uploads or 'drive' for legacy uploads.
MEDIA_UPLOAD_PROVIDER=supabase
MEDIA_UPLOAD_LEGACY_DRIVE_WRITE=false
MAX_MEDIA_FILES=20
MEDIA_UPLOAD_SESSION_TTL_MS=600000
MEDIA_UPLOAD_MAX_SESSIONS=1000

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=property-media
SUPABASE_UPLOAD_PATH_PREFIX=properties
SUPABASE_SIGNED_UPLOAD_TTL_SECONDS=900
SUPABASE_SIGNED_DOWNLOAD_TTL_SECONDS=900

# Google service account JSON, minified onto one line.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
# Optional Workspace domain-wide delegation subject.
GOOGLE_SUBJECT_EMAIL=

# Property-submission Google Sheet
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1!A1

# Contract Generation (SPEC-10 through SPEC-14)
# Public frontend origin used when issuing user/client links.
CONTRACT_PUBLIC_BASE_URL=http://localhost:5173
# At least 32 random characters. Used only to HMAC contract access tokens.
CONTRACT_TOKEN_SECRET=
# Optional server-to-server Bearer key. Never expose this as a VITE_* value.
CONTRACTS_API_KEY=
# DANGEROUS: accept browser-controlled X-User-Id outside development.
# Keep false for secure deployments.
CONTRACT_ALLOW_INSECURE_AGENT_ID=false
# Comma-separated trusted gateway user IDs allowed to use the admin API/UI.
CONTRACT_ADMIN_USER_IDS=
# In-memory defense-in-depth limits; deploy an edge/distributed limiter for
# horizontally scaled production environments.
CONTRACT_SUBMISSION_RATE_LIMIT=10
CONTRACT_SUBMISSION_RATE_WINDOW_MS=900000
# Private Supabase Storage bucket for tenant/guarantor DNI image pairs.
# The SPEC-11 migration provisions this default bucket with a 10 MB object cap.
CONTRACT_DNI_STORAGE_BUCKET=contract-dni
CONTRACT_DNI_MAX_IMAGE_BYTES=10485760
# Private Supabase Storage bucket for salary-receipt/property-guarantee files.
# The SPEC-14 migration provisions this default bucket with a 10 MB object cap.
CONTRACT_EVIDENCE_STORAGE_BUCKET=contract-evidence
CONTRACT_EVIDENCE_MAX_FILE_BYTES=10485760

# Legacy SPEC-09 compatibility endpoints only. The live UI does not use these.
CONTRACT_GOOGLE_FORM_LINK=
CONTRACT_GOOGLE_SHEET_ID=
CONTRACT_GOOGLE_SHEET_NAME=
CONTRACT_AUDIT_LOGS_DIR=

# Google Drive parent for property folders
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# Make webhook
MAKE_WEBHOOK_URL=

# Property-flow User OAuth2 credentials. Contract writes always use the
# service account above and never fall back to these values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
