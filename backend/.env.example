# Server
PORT=3001

# Media upload strategy
# Use 'supabase' for client-direct uploads (default) or 'drive' for legacy uploads.
MEDIA_UPLOAD_PROVIDER=supabase
# Allow temporary legacy multipart fallback while old clients migrate.
MEDIA_UPLOAD_LEGACY_DRIVE_WRITE=true
# Optional max files per submission / max sessions retained in memory
MAX_MEDIA_FILES=20
MEDIA_UPLOAD_SESSION_TTL_MS=600000
MEDIA_UPLOAD_MAX_SESSIONS=1000



# Supabase Storage (Supabase direct upload)
SUPABASE_URL=https://kjnwiwvwuavurbgovmlt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_CVtlbbAIl-unZEVQFDRSeQ__jeOaP8k
SUPABASE_MEDIA_BUCKET=property-media
SUPABASE_UPLOAD_PATH_PREFIX=properties
# TTL in seconds (minutes-level recommended)
SUPABASE_SIGNED_UPLOAD_TTL_SECONDS=900
SUPABASE_SIGNED_DOWNLOAD_TTL_SECONDS=900

# Google Service Account (paste the full JSON as a single-line string)
# Optional if GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, and GOOGLE_REFRESH_TOKEN are provided
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

# Google Sheets
GOOGLE_SHEET_ID=1Porjp1zud5JAaBLGNYW_7LH2n-ecBVVAKC4VHO9Hd6c
GOOGLE_SHEET_RANGE=Sheet1!A1

# Google Drive — parent folder where property folders will be created
GOOGLE_DRIVE_PARENT_FOLDER_ID=1ek_WdAGDd7eO6DMjk8JJ-n1pt0Z-12EL

# Make (Integromat) webhook URL
MAKE_WEBHOOK_URL=https://hook.us2.make.com/wehldwpd0k7y3xjhfnsogmihh9386yqe

# Google OAuth2 Credentials (User Account Authentication - Recommended to bypass Service Account storage quotas)
